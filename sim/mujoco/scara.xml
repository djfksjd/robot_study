<!-- 자동 생성: sim/mujoco/build_mjcf.py (직접 고치지 말고 scara_params.json 을 바꾼 뒤 다시 생성) -->
<mujoco model="rs450_scara">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" cone="elliptic" impratio="10" integrator="implicitfast"/>
  <visual>
    <global offwidth="960" offheight="720" azimuth="-130" elevation="-25"/>
    <quality shadowsize="4096"/>
  </visual>
  <default>
    <geom contype="0" conaffinity="0" density="2700"/>
    <default class="col">
      <geom contype="1" conaffinity="1" condim="4" friction="1.5 0.02 0.002" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.82 0.83 0.85" rgb2="0.76 0.77 0.8" width="512" height="512"/>
    <material name="table" texture="grid" texrepeat="12 12" reflectance="0.0"/>
    <material name="white" rgba="0.93 0.94 0.95 1"/>
    <material name="dark" rgba="0.23 0.25 0.28 1"/>
    <material name="chrome" rgba="0.85 0.87 0.9 1" reflectance="0.3"/>
    <material name="orange" rgba="0.95 0.55 0.16 1"/>
    <material name="blue" rgba="0.18 0.43 0.87 1"/>
    <material name="rubber" rgba="0.08 0.09 0.1 1"/>
  </asset>
  <worldbody>
    <light pos="0.6 -0.6 1.5" dir="-0.4 0.4 -1" diffuse="0.8 0.8 0.8" castshadow="true"/>
    <light pos="-0.5 0.6 1.2" dir="0.3 -0.4 -1" diffuse="0.3 0.3 0.3" castshadow="false"/>
    <geom name="table" type="plane" size="1 1 0.01" material="table" contype="1" conaffinity="1"/>
    <geom name="tray_A" type="box" pos="0.06 0.33 0.0005" size="0.03 0.03 0.0005" rgba="1 0.75 0.1 0.6" contype="0" conaffinity="0"/>
    <geom name="tray_B" type="box" pos="0.06 -0.33 0.0005" size="0.03 0.03 0.0005" rgba="1 0.75 0.1 0.6" contype="0" conaffinity="0"/>
    <camera name="overview" pos="0.95 -0.85 0.65" xyaxes="0.67 0.74 0 -0.32 0.29 0.9"/>
    <camera name="top" pos="0.2 0 1.2" xyaxes="1 0 0 0 1 0"/>

    <!-- 베이스 (고정) -->
    <geom type="box" pos="0 0 0.012" size="0.16 0.16 0.012" material="dark"/>
    <geom type="cylinder" pos="0 0 0.112" size="0.078 0.088" material="white"/>
    <geom type="cylinder" pos="0 0 0.225" size="0.092 0.025" material="dark"/>
    <geom type="box" pos="-0.12 0 0.084" size="0.04 0.055 0.06" material="dark"/>

    <body name="link1" pos="0 0 0.25" gravcomp="1">
      <joint name="j1" type="hinge" axis="0 0 1" range="-2.30383 2.30383" damping="2" armature="0.05"/>
      <geom type="cylinder" pos="0 0 0.03" size="0.07 0.028" material="white"/>
      <geom type="box" pos="0.125 0 0.03" size="0.125 0.062 0.028" material="white"/>
      <geom type="cylinder" pos="0.25 0 0.03" size="0.06 0.028" material="white"/>
      <geom type="box" pos="0.125 0 0.03" size="0.125 0.064 0.007" material="blue"/>

      <body name="link2" pos="0.25 0 0" gravcomp="1">
        <joint name="j2" type="hinge" axis="0 0 1" range="-2.53073 2.53073" damping="1.5" armature="0.03"/>
        <geom type="cylinder" pos="0 0 0.096" size="0.062 0.028" material="white"/>
        <geom type="box" pos="0.1 0 0.096" size="0.1 0.054 0.028" material="white"/>
        <geom type="box" pos="0.1 0 0.096" size="0.1 0.056 0.007" material="orange"/>
        <geom type="cylinder" pos="0 0 0.144" size="0.05 0.02" material="dark"/>
        <geom type="box" pos="0.18 0 0.159" size="0.065 0.052 0.035" material="white"/>

        <body name="quill" pos="0.2 0 0" gravcomp="1">
          <joint name="j3" type="slide" axis="0 0 -1" range="0.0 0.18" damping="30" armature="0.5"/>
          <joint name="j4" type="hinge" axis="0 0 1" range="-6.28319 6.28319" damping="0.3" armature="0.005"/>
          <geom type="cylinder" pos="0 0 0.12" size="0.01 0.17" material="chrome"/>
          <geom type="cylinder" pos="0 0 -0.055" size="0.03 0.005" material="dark"/>
          <geom type="box" pos="0 0 -0.077" size="0.022 0.048 0.017" material="orange"/>
          <site name="tcp" pos="0 0 -0.129" size="0.004" rgba="1 0 0 1"/>

          <body name="finger_left" pos="0 0 0" gravcomp="1">
            <joint name="jfl" type="slide" axis="0 1 0" range="-0.015 0.01" damping="5"/>
            <geom type="box" pos="0 0.03 -0.119" size="0.012 0.005 0.025" material="dark"/>
            <geom class="col" type="box" pos="0 0.0265 -0.129" size="0.01 0.0015 0.015" material="rubber" mass="0.01"/>
          </body>
          <body name="finger_right" pos="0 0 0" gravcomp="1">
            <joint name="jfr" type="slide" axis="0 -1 0" range="-0.015 0.01" damping="5"/>
            <geom type="box" pos="0 -0.03 -0.119" size="0.012 0.005 0.025" material="dark"/>
            <geom class="col" type="box" pos="0 -0.0265 -0.129" size="0.01 0.0015 0.015" material="rubber" mass="0.01"/>
          </body>
        </body>
      </body>
    </body>

    <body name="red" pos="0.33 0.12 0.015">
      <freejoint name="red_free"/>
      <geom class="col" type="box" size="0.015 0.015 0.015" rgba="0.851 0.212 0.212 1" mass="0.03"/>
    </body>
    <body name="green" pos="0.33 0.0 0.015">
      <freejoint name="green_free"/>
      <geom class="col" type="box" size="0.015 0.015 0.015" rgba="0.204 0.702 0.353 1" mass="0.03"/>
    </body>
    <body name="blue" pos="0.33 -0.12 0.015">
      <freejoint name="blue_free"/>
      <geom class="col" type="box" size="0.015 0.015 0.015" rgba="0.200 0.400 0.902 1" mass="0.03"/>
    </body>
  </worldbody>

  <equality>
    <joint joint1="jfl" joint2="jfr" polycoef="0 1 0 0 0"/>
  </equality>

  <actuator>
    <position name="a1" joint="j1" kp="400" kv="40" forcerange="-60 60"/>
    <position name="a2" joint="j2" kp="300" kv="25" forcerange="-40 40"/>
    <position name="a3" joint="j3" kp="20000" kv="800" forcerange="-200 200"/>
    <position name="a4" joint="j4" kp="20" kv="1" forcerange="-5 5"/>
    <position name="agrip" joint="jfl" kp="1500" kv="20" forcerange="-15 15"/>
  </actuator>
</mujoco>
